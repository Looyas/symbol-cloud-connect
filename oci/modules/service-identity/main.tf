# Internal building block shared by the finops and observability modules:
# one API-key-only user, one group containing only that user, and one API key
# whose public half was generated by Symbol (the private key never leaves Symbol).
#
# Resources are identity-domain (SCIM) resources in the tenancy's Default domain:
# - oci_identity_domains_user: a regular user whose ONLY credential is an API key -- no
#   password is set, and the capabilities extension turns off every other credential
#   type, the console password included. NOT a service user (service_user = true): OCI
#   gives a service user no API key capability and refuses both setting it (400
#   "Attribute ...canUseApiKeys is not allowed to be set on a Service User") and adding
#   a key ("You can not create ApiKey for this user"). Checked against a live identity
#   domain; up to oci-v1.0.3 the template created a service user and CreateUser failed.
# - membership is the `members` block of oci_identity_domains_group (identity domains have
#   no separate membership resource); members not declared here are removed on apply.
# - oci_identity_domains_api_key works for users of any domain and exports `fingerprint`.
# Docs: https://docs.oracle.com/en-us/iaas/tools/terraform-provider-oci/latest/docs/r/identity_domains_user.html
#       https://docs.oracle.com/en-us/iaas/tools/terraform-provider-oci/latest/docs/r/identity_domains_group.html
#       https://docs.oracle.com/en-us/iaas/tools/terraform-provider-oci/latest/docs/r/identity_domains_api_key.html

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    oci = {
      source  = "oracle/oci"
      version = ">= 9.3.0"
    }
  }
}

variable "name" {
  type        = string
  description = "User name and group name (symbol-finops or symbol-observability)."
}

variable "description" {
  type        = string
  description = "Human-readable purpose, shown on the user and the group."
}

variable "idcs_endpoint" {
  type        = string
  description = "URL of the identity domain (Default domain) hosting the service user."
}

variable "public_key_pem" {
  type        = string
  description = "Symbol-generated RSA public key (PEM) uploaded as the user's API key."
}

variable "email" {
  type        = string
  description = "Primary email of the service user. Identity domains require one by default (Primary email address required); no mail is sent to it (bypass_notification)."
}

variable "freeform_tags" {
  type        = map(string)
  description = "Contract tags (applied through the OCI tags SCIM extension)."
}

resource "oci_identity_domains_user" "this" {
  idcs_endpoint = var.idcs_endpoint
  schemas       = ["urn:ietf:params:scim:schemas:core:2.0:User"]
  user_name     = var.name
  display_name  = var.name
  description   = var.description
  active        = true
  force_delete  = true # Destroy must remove the user even though it owns an API key.

  name {
    given_name  = "Symbol"
    family_name = var.name
  }

  # Without a primary email, CreateUser fails with 400 in every domain where "Primary
  # email address required" is on -- the default for identity domains.
  emails {
    type    = "work"
    value   = var.email
    primary = true
  }

  urnietfparamsscimschemasoracleidcsextensionuser_user {
    # No welcome / activation mail: nobody signs in as this user.
    bypass_notification = true
  }

  # The API key is the only credential this user can ever hold.
  urnietfparamsscimschemasoracleidcsextensioncapabilities_user {
    can_use_api_keys                 = true
    can_use_auth_tokens              = false
    can_use_console_password         = false
    can_use_customer_secret_keys     = false
    can_use_db_credentials           = false
    can_use_oauth2client_credentials = false
    can_use_smtp_credentials         = false
  }

  urnietfparamsscimschemasoracleidcsextension_oci_tags {
    dynamic "freeform_tags" {
      for_each = var.freeform_tags
      content {
        key   = freeform_tags.key
        value = freeform_tags.value
      }
    }
  }

  lifecycle {
    # The service returns extra extension URNs in `schemas`; ignoring them avoids a
    # permanent diff (pattern from the provider's own examples). `emails`: the email is
    # only set at creation -- the service adds a `recovery` copy of the primary address,
    # and a user created by an earlier release without one must not be rewritten.
    ignore_changes = [schemas, emails]
  }
}

resource "oci_identity_domains_group" "this" {
  idcs_endpoint = var.idcs_endpoint
  schemas       = ["urn:ietf:params:scim:schemas:core:2.0:Group"]
  display_name  = var.name
  force_delete  = true

  members {
    type  = "User"
    value = oci_identity_domains_user.this.id
    ocid  = oci_identity_domains_user.this.ocid
  }

  urnietfparamsscimschemasoracleidcsextensiongroup_group {
    description = var.description
  }

  urnietfparamsscimschemasoracleidcsextension_oci_tags {
    dynamic "freeform_tags" {
      for_each = var.freeform_tags
      content {
        key   = freeform_tags.key
        value = freeform_tags.value
      }
    }
  }

  lifecycle {
    ignore_changes = [schemas]
  }
}

resource "oci_identity_domains_api_key" "this" {
  idcs_endpoint = var.idcs_endpoint
  schemas       = ["urn:ietf:params:scim:schemas:oracle:idcs:apikey"]
  key           = var.public_key_pem
  description   = "Symbol ${var.name} key (private key held by Symbol only)"

  user {
    value = oci_identity_domains_user.this.id
    ocid  = oci_identity_domains_user.this.ocid
  }

  lifecycle {
    # Key rotation: a new public key replaces this one. OCI allows up to 3 keys per user,
    # so the new key is uploaded before the old one is deleted.
    create_before_destroy = true
    # Never returned by the service (provider example).
    ignore_changes = [urnietfparamsscimschemasoracleidcsextensionself_change_user]
  }
}

output "user_ocid" {
  description = "OCID of the service user (ocid1.user...)."
  value       = oci_identity_domains_user.this.ocid
}

output "group_name" {
  description = "Group name used in policy statements."
  value       = oci_identity_domains_group.this.display_name
}

output "fingerprint" {
  description = "Fingerprint of the uploaded API key (aa:bb:...). Symbol checks it against the key pair it generated."
  value       = oci_identity_domains_api_key.this.fingerprint
}

output "email" {
  description = "Primary email the service user was created with."
  value       = var.email
}
